# ---- Backend (FastAPI) -------------------------------------------------------------
ENVIRONMENT=development                 # development | test | staging | production
DATABASE_URL=postgresql+psycopg://trialcompass:trialcompass@localhost:5432/trialcompass

# Fernet key for encrypting uploaded documents at rest. REQUIRED outside development.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=
AUDIT_IP_SALT=change-me                 # salt for hashing client IPs in the audit log
COOKIE_SECURE=false                     # set true behind HTTPS
SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=["http://localhost:3000"]

# Clinical trial data source:
#   auto     - live ClinicalTrials.gov API v2, falling back to the offline snapshot if unreachable
#   live     - live API only (errors if unreachable)
#   snapshot - offline snapshot of real registry records (data/snapshots/)
TRIAL_SOURCE=auto
CTGOV_REQUESTS_PER_MINUTE=40
TRIAL_CACHE_TTL_HOURS=24

# Real patient data guardrails. Keep both false until security, contractual (BAA) and
# regulatory safeguards are in place - see docs/PRIVACY_AND_COMPLIANCE.md.
ALLOW_REAL_PHI=false
LLM_BAA_IN_PLACE=false

# Optional LLM layer (criterion interpretation for unparsed criteria; document extraction for
# synthetic profiles / consented users with a BAA in place). Off by default.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ---- Frontend (Next.js) -------------------------------------------------------------
API_URL=http://localhost:8000           # where Next.js proxies /api/* (resolved at build time)
